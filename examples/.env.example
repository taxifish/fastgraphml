# Copy this file to examples/.env and fill it in. The .env file is ignored by git.
# The examples only ever connect to this one database.
ARANGO_URL=http://localhost:8529
ARANGO_DB=fastgraphml_examples
ARANGO_USER=fastgraphml
ARANGO_PASSWORD=change-me

# Only for https with a self-signed certificate: "false" turns the certificate
# check off, a file path names the CA certificate to trust instead.
# ARANGO_VERIFY=false
